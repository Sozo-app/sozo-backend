{
  "name": "soplay-backend",
  "version": "1.0.0",
  "description": "Soplay backend API",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test",
    "seed:admin": "node scripts/seedAdmin.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:seed": "docker compose exec app node scripts/seedAdmin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.2",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
