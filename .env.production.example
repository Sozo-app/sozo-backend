# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS (vergul bilan bir nechta origin bersa bo'ladi) ────────────────────────
# CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# ── MongoDB (docker-compose ichida avtomatik o'rnatiladi) ──────────────────────
# docker-compose.yml da shu qiymatlar ishlatiladi:
MONGO_USER=soplay
MONGO_PASS=CHANGE_ME_strong_mongo_password
# MONGODB_URI docker-compose environment da avtomatik hosil bo'ladi

# ── JWT Secrets (ALBATTA O'ZGARTIRING!) ────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_random_64_char_string_here
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_string_here
MEDIA_SECRET=CHANGE_ME_media_ref_secret_here

# ── Admin JWT (ALBATTA O'ZGARTIRING!) ──────────────────────────────────────────
ADMIN_JWT_ACCESS_SECRET=CHANGE_ME_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=CHANGE_ME_admin_refresh_secret

# ── Admin Seed ─────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Firebase ───────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com
OTP_TTL_MINUTES=10

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket
R2_PUBLIC_URL=https://your-cdn.domain.com

# ── Provider sozlamalari (ixtiyoriy) ──────────────────────────────────────────
# KINOGO_BASE_URL=https://kinogo-film.my
# KINOGO_COOKIE=cf_clearance=xxx
# VIDSRC_BASE_URL=https://vidsrc.ru
# WYZIE_API_KEY=xxx
# TMDB_PROXY_URL=https://jumpfreedom.com/3
# TMDB_API_KEY=configure-as-a-server-secret-only; never add to Android/Web client builds
# STREMIO_ADDONS=https://addon-one.example/manifest.json,https://addon-two.example/manifest.json
# Stremio manifests are optional, HTTPS-only, and must resolve to public IP addresses.
